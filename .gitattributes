# Windows-only scripts: force CRLF line endings on checkout AND in GitHub ZIP archives.
# Without this, GitHub "Download ZIP" serves these files with LF endings, which makes
# cmd.exe misparse the batch syntax (commands split mid-line, fragments treated as
# separate commands). Affects anyone who downloads via ZIP instead of git clone.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts: force LF (in case anyone commits one from Windows in the future).
*.sh    text eol=lf

# Audit originals and execution artifacts retain their exact evidence bytes.
docs/superpowers/specs/2026-10-07-mes-expectations.sources/** -text
# Preserved Windows JSON snapshots use CRLF without changing their source hashes.
docs/superpowers/specs/2026-10-07-mes-expectations.sources/schema1-policy.json whitespace=trailing-space,space-before-tab,cr-at-eol
docs/superpowers/specs/2026-10-07-mes-expectations.sources/schema1-registry.json whitespace=trailing-space,space-before-tab,cr-at-eol
